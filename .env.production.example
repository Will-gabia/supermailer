NODE_ENV=production

# management-console container
MANAGEMENT_CONSOLE_PORT=3000
MANAGEMENT_CONSOLE_HOST=0.0.0.0

# mail-worker container
MAIL_WORKER_PORT=3001
MAIL_WORKER_HOST=0.0.0.0

# external infrastructure
DATABASE_URL=postgres://supermailer:<strong-password>@postgres.example.internal:5432/supermailer
REDIS_URL=redis://redis.example.internal:6379

# admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
AUTH_TOKEN_SECRET=<long-random-secret>
SESSION_COOKIE_NAME=supermailer_admin_session
SESSION_TTL_HOURS=24

# external SMTP relay / postfix
SENDSMTP_HOST=postfix.example.internal
SENDSMTP_PORT=25
